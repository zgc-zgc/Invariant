# API Configuration (支持任何LLM API)
API_ENDPOINT=https://your-api-endpoint.com/v1/chat
API_KEY=your-api-key
MODEL_NAME=your-model-name

# Error Handling & Retry Configuration
RETRY_ENABLED=true
MAX_RETRIES=5
RETRY_DELAY_MS=1000
HANDLE_429=true

# Original Convergence Control
MIN_ROUNDS=3
MAX_ROUNDS=10
DISCOVERY_THRESHOLD=0.1

# Challenge System Configuration
MAX_CHALLENGE_ROUNDS=5

# Debugging & Logging
DEBUG=false
LOG_LEVEL=info